/* Linker script for OpenE902 smart_run (MEM1=256KB @ 0x0, MEM2=768KB @ 0x20000000) */
MEMORY
{
    MEM1 (RWX) : ORIGIN = 0x00000000, LENGTH = 0x40000
    MEM2 (RWX) : ORIGIN = 0x20000000, LENGTH = 0xc0000
}

__kernel_stack = 0x200bfff8;

ENTRY(__start)

SECTIONS {
    .text :
    {
        *crt0.o (.text)
        *(.text*)
        . = ALIGN(0x10);
    } > MEM1

    .rodata :
    {
        *(.rodata*)
        . = ALIGN(0x4);
        __erodata = .;
    } > MEM1

    .data :
    {
        . = ALIGN(0x4);
        __data_start__ = .;
        *(.data*)
        *(.sdata*)
        *(.eh_frame*)
        . = ALIGN(0x4);
        __data_end__ = .;
    } > MEM2 AT > MEM1

    .bss :
    {
        . = ALIGN(0x4);
        __bss_start__ = .;
        *(.bss*)
        *(.sbss*)
        *(COMMON)
        . = ALIGN(0x4);
        __bss_end__ = .;
    } > MEM2
}
